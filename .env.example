DJANGO_SETTINGS_MODULE=config.settings.local
DJANGO_SECRET_KEY=dev-only-not-a-secret

# Two connections, deliberately. The application never holds schema privileges,
# and CREATE EXTENSION is executed by the owner during migration (DB-4, SEC-41).
#
# `127.0.0.1` and never `localhost`. The containers publish on the IPv4 loopback only
# (SEC-58, DB-11), and a host that resolves `localhost` to `::1` first will wait for that
# connection to time out on every single connection it opens.
DATABASE_URL=postgres://shoerag_app:dev_app_password@127.0.0.1:5432/shoerag
MIGRATION_DATABASE_URL=postgres://shoerag_owner:dev_owner_password@127.0.0.1:5432/shoerag

# The role names the grants in `apps.audit.migrations.0002_privileges` apply to. Set only where a
# managed platform issues its own names; the defaults match the local composition. A wrong name
# here is refused by that migration rather than ignored, because privilege separation that appears
# to be in place and is not is worse than none (DB-69).
DB_APP_ROLE=shoerag_app
DB_READONLY_ROLE=shoerag_readonly

CELERY_BROKER_URL=redis://127.0.0.1:6379/0

# Evidential files live outside the repository. No absolute path appears in source, so this
# is the only place the location is stated (architecture.md 2.4).
SHOERAG_STORAGE_ROOT=./var/storage
SIGNED_URL_TTL_SECONDS=600
